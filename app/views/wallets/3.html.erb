<!-- app/views/wallets/deposit.html.erb -->
<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <!-- Pawapay Option -->
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawa.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing with no fees.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= simple_form_for @transaction, url: process_deposit_wallet_path,
          html: { class: 'needs-validation', novalidate: true } do |f| %>

          <div class="alert alert-danger" id="depositErrors" style="display:none;"></div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-4">
                <%= f.input :payment_method,
                            label: 'Payment Method',
                            collection: [
                              ['Pawapay', 'pawapay'],
                              ['Orange Money', 'orange_money'],
                              ['MTN Mobile Money', 'mtn_momo']
                            ],
                            include_blank: false,
                            input_html: {
                              class: 'form-select form-select-lg',
                              id: 'paymentMethodSelect'
                            } %>
              </div>

              <div class="mb-3" id="amountField">
                <%= f.input :amount,
                            label: 'Amount ',
                            required: true,
                            input_html: {
                              class: 'form-control form-control-lg',
                              min: 100,
                              step: 100,
                              pattern: '\d*'
                            } %>
                <small class="form-text text-muted">
                  Minimum deposit: 100
                </small>
              </div>

              <div class="mb-3" id="phoneField">
                <div class="row g-2">
                  <div class="col-4">
                    <label class="form-label">Country Code</label>
                    <select class="form-select form-select-lg" id="countryCode">
                      <option value="237" data-pattern="^237\d{9}$" data-length="12">Cameroon (+237)</option>
                      <option value="234" data-pattern="^234\d{10}$" data-length="13">Nigeria (+234)</option>
                      <option value="1" data-pattern="^1\d{10}$" data-length="11">USA (+1)</option>
                      <option value="44" data-pattern="^44\d{10}$" data-length="12">UK (+44)</option>
                    </select>
                  </div>
                  <div class="col-8">
                    <%= f.input :phone_number,
                                label: 'Mobile Number',
                                required: true,
                                input_html: {
                                  class: 'form-control form-control-lg',
                                  placeholder: 'xxxxxxxxx',
                                  # pattern: '^237\d{9}$',
                                  minlength: 8,
                                  maxlength: 16
                                } %>
                    <small class="form-text text-muted" id="phoneHelp">
                      Format: country code followed by 9 digits
                    </small>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card border-0 bg-light p-4">
                <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Transaction Summary</h5>
                <dl class="row">
                  <dt class="col-6">Payment Method</dt>
                  <dd class="col-6" id="methodPreview">-</dd>
                  <dt class="col-6">Amount</dt>
                  <dd class="col-6" id="amountPreview">-</dd>
                </dl>
                <div class="alert alert-info mt-3">
                  <i class="bi bi-clock-history me-2"></i>
                  <span id="processingTime">Processing time: Instant</span>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions text-center mt-4">
            <%= f.button :submit, 'Proceed to Payment',
                        class: 'btn btn-primary btn-lg w-100 py-3',
                        data: { disable_with: 'Processing...' } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const paymentMethod = document.getElementById('paymentMethodSelect');
  const countryCode = document.getElementById('countryCode');
  const phoneInput = document.querySelector('[name="transaction[phone_number]"]');
  const phoneHelp = document.getElementById('phoneHelp');
  const amountInput = document.getElementById('transaction_amount');

  // Country code change handler
  function updatePhoneValidation() {
    const selected = countryCode.options[countryCode.selectedIndex];
    const code = selected.value;
    const pattern = selected.dataset.pattern;
    const maxLength = parseInt(selected.dataset.length);
    const digitCount = maxLength - code.length;

    phoneInput.pattern = pattern;
    phoneInput.minLength = minLength;
    phoneInput.maxLength = maxLength;
    phoneInput.placeholder = `${'X'.repeat(digitCount)}`;
    phoneHelp.textContent = `Format: ${code} followed by ${digitCount} digits`;

    // Trigger validation update
    phoneInput.dispatchEvent(new Event('input'));
  }

  // Phone number formatting
  function formatPhoneNumber() {
    const code = countryCode.value;

    // Remove all non-digit characters
    let numbers = phoneInput.value.replace(/\D/g, '');

    // Prepend country code if missing
    if (!numbers.startsWith(code)) {
      numbers = code + numbers.replace(new RegExp(`^${code}`), '');
    }

    // Trim to max length
    const maxLength = parseInt(countryCode.options[countryCode.selectedIndex].dataset.length);
    phoneInput.value = numbers.slice(0, maxLength);

    // Validate and update styles
    const isValid = phoneInput.checkValidity();
    phoneInput.classList.toggle('is-invalid', !isValid);
    phoneInput.classList.toggle('is-valid', isValid);
  }

  // Payment method and amount preview
  function updatePreview() {
    const amount = parseFloat(amountInput.value) || 0;
    document.getElementById('amountPreview').textContent = `${amount.toFixed(2)} `;
    document.getElementById('methodPreview').textContent = paymentMethod.options[paymentMethod.selectedIndex].text;
    document.getElementById('processingTime').textContent = paymentMethod.value === 'pawapay' ?
      'Processing time: 2-5 minutes' : 'Processing time: Instant';
  }

  // Event listeners
  countryCode.addEventListener('change', updatePhoneValidation);
  phoneInput.addEventListener('input', formatPhoneNumber);
  paymentMethod.addEventListener('change', updatePreview);
  amountInput.addEventListener('input', updatePreview);

  // Initial setup
  updatePhoneValidation();
  updatePreview();
});
</script>

<style>
.is-valid {
  border-color: #28a745 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
}

.is-invalid {
  border-color: #dc3545 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
}
</style>
