<!-- app/views/wallets/deposit.html.erb -->
<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <!-- Pawapay Option -->
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawa.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing with no fees.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= simple_form_for @transaction, url: process_deposit_wallet_path,
          html: { class: 'needs-validation', novalidate: true } do |f| %>

          <div class="alert alert-danger" id="depositErrors" style="display:none;"></div>

          <div class="row">
            <div class="col-md-6">
              <!-- Payment Method Field -->
              <div class="mb-4">
                <%= f.input :payment_method,
                            label: 'Payment Method',
                            collection: [
                              ['Pawapay', 'pawapay'],
                              ['Orange Money', 'orange_money'],
                              ['MTN Mobile Money', 'mtn_momo']
                            ],
                            include_blank: false,
                            input_html: {
                              class: 'form-select form-select-lg',
                              id: 'paymentMethodSelect'
                            } %>
              </div>

              <!-- Amount Field -->
              <div class="mb-3" id="amountField">
                <%= f.input :amount,
                            label: 'Amount (XAF)',
                            required: true,
                            input_html: {
                              class: 'form-control form-control-lg',
                              min: 100,
                              step: 100,
                              pattern: '\d*'
                            } %>
                <small class="form-text text-muted">
                  Minimum deposit: 100 XAF
                </small>
              </div>

              <!-- Phone Number Field -->
              <div class="mb-3" id="phoneField">
                <div class="row g-2 align-items-end">
                  <div class="col-4">
                    <label class="form-label">Country Code</label>
                    <select class="form-select form-select-lg" id="countryCode">
                      <option value="237" data-pattern="^237\d+$">Cameroon (+237)</option>
                      <option value="234" data-pattern="^234\d+$">Nigeria (+234)</option>
                      <option value="1" data-pattern="^1\d+$">USA (+1)</option>
                      <option value="44" data-pattern="^44\d+$">UK (+44)</option>
                    </select>
                  </div>
                  <div class="col-8">
                    <div class="form-group">
                      <label class="form-label">Mobile Number</label>
                      <input type="tel"
                             class="form-control form-control-lg"
                             name="transaction[phone_number]"
                             id="phoneInput"
                             required
                             pattern="^237\d+$"
                             minlength="8"
                             maxlength="16"
                             placeholder="681234567">
                      <small class="form-text text-muted" id="phoneHelp">
                        Enter 8-16 digits including country code
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Transaction Summary -->
            <div class="col-md-6">
              <div class="card border-0 bg-light p-4 h-100">
                <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Transaction Summary</h5>
                <dl class="row">
                  <dt class="col-6">Payment Method</dt>
                  <dd class="col-6" id="methodPreview">-</dd>
                  <dt class="col-6">Amount</dt>
                  <dd class="col-6" id="amountPreview">-</dd>
                </dl>
                <div class="alert alert-info mt-3 mb-0">
                  <i class="bi bi-clock-history me-2"></i>
                  <span id="processingTime">Processing time: Instant</span>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions text-center mt-4">
            <button type="submit"
                    class="btn btn-primary btn-lg w-100 py-3"
                    id="submitButton"
                    data-disable-with="Processing...">
              Proceed to Payment
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const paymentMethod = document.getElementById('paymentMethodSelect');
  const countryCode = document.getElementById('countryCode');
  const phoneInput = document.getElementById('phoneInput');
  const phoneHelp = document.getElementById('phoneHelp');
  const amountInput = document.getElementById('transaction_amount');

  // Update phone validation when country changes
  function updatePhoneValidation() {
    const selected = countryCode.options[countryCode.selectedIndex];
    phoneInput.pattern = selected.dataset.pattern;
    phoneInput.value = '';
    phoneHelp.textContent = `Format: ${selected.value} followed by 8-16 digits`;
    validateForm();
  }

  // Format and validate phone number
  function formatPhoneNumber() {
    const code = countryCode.value;
    let numbers = phoneInput.value.replace(/\D/g, '');

    // Prepend country code if missing
    if (!numbers.startsWith(code)) {
      numbers = code + numbers;
    }

    // Trim to max length and update value
    phoneInput.value = numbers.slice(0, 16);

    // Validate input
    const isValid = phoneInput.checkValidity();
    phoneInput.classList.toggle('is-valid', isValid);
    phoneInput.classList.toggle('is-invalid', !isValid);
  }

  // Update preview information
  function updatePreview() {
    const amount = parseFloat(amountInput.value) || 0;
    document.getElementById('amountPreview').textContent = `${amount.toFixed(2)} XAF`;
    document.getElementById('methodPreview').textContent =
      paymentMethod.options[paymentMethod.selectedIndex].text;
    document.getElementById('processingTime').textContent =
      paymentMethod.value === 'pawapay' ? '2-5 minutes' : 'Instant';
  }

  // Validate entire form
  function validateForm() {
    const isValid = document.querySelector('form.needs-validation').checkValidity();
    document.getElementById('submitButton').disabled = !isValid;
  }

  // Event listeners
  countryCode.addEventListener('change', () => {
    updatePhoneValidation();
    formatPhoneNumber();
  });

  phoneInput.addEventListener('input', () => {
    formatPhoneNumber();
    validateForm();
  });

  paymentMethod.addEventListener('change', () => {
    updatePreview();
    validateForm();
  });

  amountInput.addEventListener('input', () => {
    updatePreview();
    validateForm();
  });

  // Initial setup
  updatePhoneValidation();
  updatePreview();
  validateForm();
});
</script>

<style>
.form-control-lg {
  padding: 0.8rem 1rem;
  font-size: 1.1rem;
}

.form-select-lg {
  padding: 0.8rem 2.25rem 0.8rem 1rem;
}

.is-valid {
  border-color: #198754 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
}

.is-invalid {
  border-color: #dc3545 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
}

#phoneHelp {
  font-size: 0.875em;
  margin-top: 0.25rem;
}
</style>
