<!-- app/views/wallets/deposit.html.erb -->
<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <!-- Pawapay Option -->
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawa.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing with no fees.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
      <%# Display server‑side validation errors %>
      <% if @transaction.errors.any? %>
        <div class="alert alert-danger">
          <h6 class="alert-heading">Please fix the following:</h6>
          <ul class="mb-0">
            <% @transaction.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h2>Deposit Funds</h2>

  <%= form_with model: @transaction, url: process_deposit_wallet_path, local: true do |f| %>
    <% if @transaction.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @transaction.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Amount -->
    <div class="mb-3">
      <%= f.label :amount, 'Amount (XAF)' %>
      <%= f.number_field :amount, step: 1, class: 'form-control', required: true %>
    </div>

    <!-- Phone Number -->
    <div class="mb-3">
      <%= f.label :phone_number, 'Phone Number (e.g. 2376XXXXXXXX)' %>
      <%= f.telephone_field :phone_number, class: 'form-control', required: true %>
    </div>

    <!-- Payment Method -->
    <div class="mb-3">
      <%= f.label :payment_method, 'Select Payment Method' %>
      <%= f.select :payment_method,
            options_for_select([['PawaPay', 'pawapay'], ['MTN MoMo', 'mtn_momo'], ['Orange Money', 'orange_money']]),
            {}, class: 'form-select', required: true %>
    </div>

    <!-- Optional: Currency -->
    <%= f.hidden_field :currency, value: 'XAF' %>

    <!-- Hidden deposit_id (auto-generated in controller if not present) -->
    <%= f.hidden_field :deposit_id, value: @transaction.deposit_id %>

    <div class="mt-3">
      <%= f.submit 'Proceed to Payment', class: 'btn btn-primary' %>
    </div>
  <% end %>

    </div>

    </div>
  </div>
</div>

  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const amountEl   = document.getElementById('amountInput');
    const phoneEl    = document.getElementById('phoneInput');
    const methodEl   = document.getElementById('paymentMethod');

    const sumAmt     = document.getElementById('summaryAmount');
    const sumPhone   = document.getElementById('summaryPhone');
    const sumMethod  = document.getElementById('summaryMethod');
    const note       = document.getElementById('processingNote');

    function updateSummary() {
      sumAmt.textContent    = amountEl.value ? `${amountEl.value} XAF` : '–';
      sumPhone.textContent  = phoneEl.value    || '–';
      const sel = methodEl.options[methodEl.selectedIndex];
      sumMethod.textContent = sel && sel.value ? sel.text : '–';

      note.textContent = methodEl.value === 'pawapay'
        ? 'Processing time: 2–5 minutes'
        : 'Processing time: Instant';
    }

    [amountEl, phoneEl, methodEl].forEach(el => {
      el.addEventListener('input', updateSummary);
      el.addEventListener('change', updateSummary);
    });

    updateSummary();
  });
</script>

<style>
.form-control-lg {
  padding: 0.8rem 1rem;
  font-size: 1.1rem;
}

.form-select-lg {
  padding: 0.8rem 2.25rem 0.8rem 1rem;
}

.is-valid {
  border-color: #198754 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
}

.is-invalid {
  border-color: #dc3545 !important;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
}

#phoneHelp {
  font-size: 0.875em;
  margin-top: 0.25rem;
}
</style>
