<!-- app/views/wallets/deposit.html.erb -->

<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawa.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing with no fees.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="deposit-form">
          <input type="hidden" id="currency" value="XAF">
          <input type="hidden" id="transaction_type" value="deposit">

          <div class="mb-3">
            <label for="amount" class="form-label">Amount (XAF)</label>
            <input type="number" class="form-control" id="amount" required min="100">
          </div>

          <div class="mb-3">
            <label for="msisdn" class="form-label">Phone Number (e.g. 2376xxxxxxx)</label>
            <input type="text" class="form-control" id="msisdn" required pattern="^237[6-9]\d{7}$" title="Enter a valid Cameroonian phone number starting with 237">
          </div>

          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-arrow-up-right-circle me-2"></i> Deposit with Pawapay
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Loading Overlay -->
<div id="loading-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:1050; align-items:center; justify-content:center;">
  <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
    <span class="visually-hidden">Processing...</span>
  </div>
</div>

<!-- JavaScript: handle deposit flow -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("deposit-form");
    const overlay = document.getElementById("loading-overlay");

    form.addEventListener("submit", async function(e) {
      e.preventDefault();

      const depositId = crypto.randomUUID();
      const amount = document.getElementById("amount").value;
      const msisdn = document.getElementById("msisdn").value;
      const currency = document.getElementById("currency").value;
      const transactionType = document.getElementById("transaction_type").value;

      overlay.style.display = "flex";

      try {
        // Step 1: Create transaction in your Rails backend
        const initResponse = await fetch("/transactions/initiate_pawapay", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").getAttribute("content")
          },
          body: JSON.stringify({
            deposit_id: depositId,
            amount: amount,
            phone_number: msisdn,
            currency: currency,
            transaction_type: transactionType
          })
        });

        const initData = await initResponse.json();

        if (initData.status !== "ok") {
          alert("Transaction failed: " + (initData.message || "Unknown error."));
          return;
        }

        // Step 2: Create Pawapay session from your backend (secure)
        const sessionResponse = await fetch("/pawapay/create_session", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").getAttribute("content")
          },
          body: JSON.stringify({
            deposit_id: depositId,
            amount: amount,
            msisdn: msisdn
          })
        });

        const sessionData = await sessionResponse.json();

        if (sessionData.session_url) {
          window.location.href = sessionData.session_url;
        } else {
          alert("Pawapay session error: " + (sessionData.error || "Could not create session."));
        }

      } catch (err) {
        console.error("Error:", err);
        alert("An unexpected error occurred.");
      } finally {
        overlay.style.display = "none";
      }
    });
  });
</script>
