<!-- app/views/wallets/deposit.html.erb -->
<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <!-- Pawapay Option -->
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawapay.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing and best exchange rates.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>

        <!-- Existing Mobile Money Options -->
        <!-- ... (keep your existing orange_money and mtn_momo sections) ... -->
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= simple_form_for @transaction, url: process_deposit_wallet_path,
          html: { class: 'needs-validation', novalidate: true } do |f| %>

          <div class="alert alert-danger" id="depositErrors" style="display:none;"></div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-4">
                <%= f.input :payment_method,
                            label: 'Payment Method',
                            collection: [
                              ['Pawapay', 'pawapay'],
                              ['Orange Money', 'orange_money'],
                              ['MTN Mobile Money', 'mtn_momo']
                            ],
                            include_blank: false,
                            input_html: {
                              class: 'form-select form-select-lg',
                              id: 'paymentMethodSelect'
                            } %>
              </div>

              <div class="mb-3" id="amountField">
                <%= f.input :amount,
                            label: 'Amount',
                            required: true,
                            input_html: {
                              class: 'form-control form-control-lg',
                              min: 100,
                              step: 100,
                              pattern: '\d*'
                            } %>
                <small class="form-text text-muted">
                  Minimum deposit: 100 XAF (~0.16 USD)
                </small>
              </div>

              <div class="mb-3" id="phoneField" style="<%= 'display:none;' unless @transaction.mobile_money? %>">
                <%= f.input :phone_number,
                            label: 'Mobile Number',
                            required: true,
                            input_html: {
                              class: 'form-control form-control-lg',
                              placeholder: 'Enter your mobile number'
                            } %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card border-0 bg-light p-4">
                <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Transaction Summary</h5>
                <dl class="row">
                  <dt class="col-6">Payment Method</dt>
                  <dd class="col-6" id="methodPreview">-</dd>

                  <dt class="col-6">Amount</dt>
                  <dd class="col-6" id="amountPreview">-</dd>

                  <dt class="col-6">Fee</dt>
                  <dd class="col-6" id="feePreview">0.00 XAF</dd>

                  <dt class="col-6">Total</dt>
                  <dd class="col-6" id="totalPreview">-</dd>
                </dl>

                <div class="alert alert-info mt-3">
                  <i class="bi bi-clock-history me-2"></i>
                  <span id="processingTime">Processing time: Instant</span>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions text-center mt-4">
            <%= f.button :submit, 'Proceed to Payment',
                        class: 'btn btn-primary btn-lg w-100 py-3',
                        data: { disable_with: 'Processing...' } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const paymentMethod = document.getElementById('paymentMethodSelect');
  const phoneField = document.getElementById('phoneField');
  const amountInput = document.getElementById('transaction_amount');

  function updateForm() {
    const method = paymentMethod.value;

    // Phone number field handling
    if (method === 'pawapay') {
      phoneField.style.display = 'block';
      document.querySelector('[name="transaction[phone_number]"]').required = true;
      document.querySelector('[name="transaction[phone_number]"]').pattern = null;
    } else if (method === 'orange_money' || method === 'mtn_momo') {
      phoneField.style.display = 'block';
      document.querySelector('[name="transaction[phone_number]"]').pattern = '^237\d{9}$';
    } else {
      phoneField.style.display = 'none';
    }

    // Update preview
    document.getElementById('methodPreview').textContent =
      paymentMethod.options[paymentMethod.selectedIndex].text;
  }

  function updatePreview() {
    const amount = parseFloat(amountInput.value) || 0;
    const method = paymentMethod.value;

    // Calculate fees (example: 1.5% fee for mobile money)
    const fee = method === 'pawapay' ? 0 : amount * 0.015;
    const total = method === 'pawapay' ? amount : amount + fee;

    document.getElementById('amountPreview').textContent =
      `${amount.toFixed(2)} XAF`;
    document.getElementById('feePreview').textContent =
      `${fee.toFixed(2)} XAF`;
    document.getElementById('totalPreview').textContent =
      `${total.toFixed(2)} XAF`;

    // Update processing time
    document.getElementById('processingTime').textContent =
      method === 'pawapay' ? 'Processing time: 2-5 minutes' : 'Processing time: Instant';
  }

  paymentMethod.addEventListener('change', updateForm);
  amountInput.addEventListener('input', updatePreview);

  // Initial setup
  updateForm();
  updatePreview();
});
</script>
