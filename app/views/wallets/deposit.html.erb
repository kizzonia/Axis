<!-- app/views/wallets/deposit.html.erb -->

<div class="dashboard__main pl0-md">
  <div class="dashboard__content bgc-gmart-gray">
    <div class="row pb50">
      <div class="col-lg-12">
        <div class="dashboard_title_area">
          <h2>Top Up Wallet</h2>
          <p class="para">Choose From Payment Methods Below</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-10">
        <!-- Pawapay Option -->
        <div class="row recent_activity_widget">
          <div class="col-md-4">
            <div class="d-flex align-items-center bb1 pb30">
              <div class="flex-shrink-0 thu">
                <%= image_tag 'pawa.svg', alt: 'Pawapay', style: 'width: 120px;' %>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <p><strong>Secure payments with Pawapay - supports all mobile money networks and credit/debit cards. Instant processing with no fees.</strong></p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#depositModal">
              <i class="bi bi-credit-card me-2"></i> Make Deposit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="depositModalLabel">
          <i class="bi bi-wallet2 me-2"></i> Deposit Funds
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <h4>Deposit Funds</h4>

        <form id="deposit-form">
          <input type="hidden" id="deposit_id" value="<%= SecureRandom.uuid %>">
          <input type="hidden" id="currency" value="XAF">
          <input type="hidden" id="transaction_type" value="deposit">

          <div class="mb-3">
            <label for="amount" class="form-label">Amount (XAF)</label>
            <input type="number" class="form-control" id="amount" required>
          </div>

          <div class="mb-3">
            <label for="msisdn" class="form-label">Phone Number (e.g. 2376xxxxxxx)</label>
            <input type="text" class="form-control" id="msisdn" required>
          </div>

          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-arrow-up-right-circle me-2"></i> Deposit with Pawapay
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- JS to call /transactions/initiate_pawapay and then redirect to Pawapay -->
<script>
  document.getElementById("deposit-form").addEventListener("submit", function(e) {
    e.preventDefault();

    const depositId = document.getElementById("deposit_id").value;
    const amount = document.getElementById("amount").value;
    const msisdn = document.getElementById("msisdn").value;
    const currency = document.getElementById("currency").value;
    const transactionType = document.getElementById("transaction_type").value;

    // First: Call your backend to create the transaction record
    fetch("/transactions/initiate_pawapay", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").getAttribute("content")
      },
      body: JSON.stringify({
        deposit_id: depositId,
        amount: amount,
        phone_number: msisdn,
        currency: currency,
        transaction_type: transactionType
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status !== "ok") {
        alert("Transaction failed: " + (data.message || "Unknown error."));
        return;
      }

      // Next: Call Pawapay session API
      const payload = {
        depositId: depositId,
        returnUrl: "<%= pawapay_return_url_url %>?depositId=" + depositId,
        statementDescription: "Wallet deposit",
        amount: amount,
        msisdn: msisdn,
        language: "EN",
        country: "CMR",
        reason: "Wallet funding",
        metadata: [
          { fieldName: "userId", fieldValue: "<%= current_user.id %>" },
          { fieldName: "depositId", fieldValue: depositId }
        ]
      };

      return fetch("https://api.pawapay.io/v1/widget/sessions", {
        method: "POST",
        headers: {
          "Authorization": "Bearer <%= ENV['PAWAPAY_SECRET_KEY'] %>",
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
      });
    })
    .then(response => response.json())
    .then(pawaRes => {
      if (pawaRes.sessionUrl) {
        window.location.href = pawaRes.sessionUrl;
      } else {
        alert("Pawapay session error: " + (pawaRes.error || "Could not create session."));
      }
    })
    .catch(err => {
      console.error(err);
      alert("An unexpected error occurred.");
    });
  });
</script>
