<!-- app/views/orders/show.html.erb -->
<section class="shop-checkouts pt30">
  <div class="container">
    <div class="row">
      <div class="col-sm-6 col-lg-4 m-auto">
        <div class="main-title text-center mb50">
          <h2 class="title">Payment And Communication</h2>
        </div>
      </div>
    </div>
      <!-- ─── LEFT: Chat & Order Details ─────────────────────────────────── -->


<div class="row">
  <div class="col-lg-8 col-xl-8">
<div class="checkout_form style2">
  <div class="row mt-5">
    <div class="m-auto">
      <h4 class="mb-4">Escrow Progress</h4>

      <!-- Enhanced Timeline -->
      <div class="timeline-progress mb-4">
        <div class="progress-bar" role="progressbar"
             style="width: <%= @order.progress_percentage %>%"
             aria-valuenow="<%= @order.progress_percentage %>"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
      </div>

      <ul class="timeline list-unstyled">
        <li class="timeline-item completed">
          <div class="timeline-marker">
            <span class="timeline-icon bg-primary">
              <i class="fas fa-file-invoice"></i>
            </span>
          </div>
          <div class="timeline-content shadow-sm">
            <h6 class="fw-bold">Order Created</h6>
            <p class="text-muted mb-0">
              <i class="fas fa-clock me-1"></i>
              <%= @order.created_at.strftime("%d %b %Y, %I:%M %p") %>
            </p>
          </div>
        </li>

        <li class="timeline-item <%= 'completed' if @order.paid? %>">
          <div class="timeline-marker">
            <span class="timeline-icon bg-info">
              <i class="fas fa-lock"></i>
            </span>
          </div>
          <div class="timeline-content shadow-sm">
            <h6 class="fw-bold">Payment Escrowed</h6>
            <% if @order.paid_at %>
              <p class="text-muted mb-0">
                <i class="fas fa-clock me-1"></i>
                <%= @order.paid_at.strftime("%d %b %Y, %I:%M %p") %>
              </p>
            <% else %>
              <div class="alert alert-warning py-1 px-2 mt-2 d-inline-block">
                <i class="fas fa-exclamation-circle me-1"></i>
                Awaiting payment
              </div>
            <% end %>
          </div>
        </li>

        <li class="timeline-item <%= 'completed' if @order.shipped? %>">
          <div class="timeline-marker">
            <span class="timeline-icon bg-warning">
              <i class="fas fa-shipping-fast"></i>
            </span>
          </div>
          <div class="timeline-content shadow-sm">
            <h6 class="fw-bold">Shipment Proof Uploaded</h6>
            <% if @order.shipped_at %>
              <p class="text-muted mb-0">
                <i class="fas fa-clock me-1"></i>
                <%= @order.shipped_at.strftime("%d %b %Y, %I:%M %p") %>
              </p>
              <% if @order.shipment_proof.attached? %>
                <a href="<%= url_for(@order.shipment_proof) %>"
                   class="btn btn-sm btn-outline-primary mt-2"
                   target="_blank">
                  <i class="fas fa-eye me-1"></i>View Proof
                </a>
              <% end %>
            <% else %>
              <div class="alert alert-warning py-1 px-2 mt-2 d-inline-block">
                <i class="fas fa-exclamation-circle me-1"></i>
                Awaiting shipment
              </div>
            <% end %>
          </div>
        </li>

        <li class="timeline-item <%= 'completed' if @order.completed? %>">
          <div class="timeline-marker">
            <span class="timeline-icon bg-success">
              <i class="fas fa-check-circle"></i>
            </span>
          </div>
          <div class="timeline-content shadow-sm">
            <h6 class="fw-bold">Funds Released</h6>
            <% if @order.completed_at %>
              <p class="text-muted mb-0">
                <i class="fas fa-clock me-1"></i>
                <%= @order.completed_at.strftime("%d %b %Y, %I:%M %p") %>
              </p>
              <div class="alert alert-success py-1 px-2 mt-2 d-inline-block">
                <i class="fas fa-check-circle me-1"></i>
                Transaction completed
              </div>
            <% else %>
              <div class="alert alert-light py-1 px-2 mt-2 d-inline-block">
                <i class="fas fa-ellipsis-h me-1"></i>
                Pending release
              </div>
            <% end %>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>
</div>


      <!-- ─── RIGHT: Order Sidebar & Actions ────────────────────────────── -->
      <div class="col-lg-4">
        <div class="order_sidebar_widget checkout_page mb30">
          <h4 class="title">Your Order</h4>
          <ul>
            <% @order.order_items.each do |item| %>
              <li class="subtitle">
                <p>
                  <%= item.product.name %>
                  <span class="float-end"><%= item.quantity %>×<%= number_to_currency(item.price) %></span>
                </p>
              </li>
            <% end %>
          </ul>
        </div>

        <div class="order_sidebar_widget checkout_page mb30">
          <h4 class="title">Delivery Details</h4>
          <ul>
            <li class="subtitle">
              <p>Name: <span class="float-end"><%= @order.first_name %> <%= @order.last_name %></span></p>
            </li>
            <li class="subtitle">
              <p>Address: <span class="float-end"><%= [@order.street_address, @order.city, @order.state, @order.zip_code].join(", ") %></span></p>
            </li>
            <li class="subtitle">
              <p>Country: <span class="float-end"><%= @order.country %></span></p>
            </li>
            <li class="subtitle">
              <p>Contact: <span class="float-end"><%= @order.email %> / <%= @order.phone %></span></p>
            </li>
          </ul>
        </div>

        <div class="order_sidebar_widget checkout_page mb30">
          <h4 class="title">Order Summary</h4>
          <ul>
            <li class="subtitle">
              <p>Subtotal: <span class="float-end"><%= number_to_currency(@order.total_amount, unit: 'XAF') %></span></p>
            </li>
            <li class="subtitle">
              <p>Total: <span class="float-end"><%= number_to_currency(@order.total_amount, unit: 'XAF') %></span></p>
            </li>
          </ul>

          <!-- ─── Action Buttons ─────────────────────────────────────── -->
          <div class="mt-3 text-center">

            <%# 1) Pending → Pay Holding Escrow %>
            <% if current_user == @order.user && @order.pending? %>
              <%= button_to "Pay & Hold (#{number_to_currency(@order.total_amount, unit: 'XAF')})",
                   pay_escrow_order_path(@order),
                   method: :post,
                   class: "btn btn-success mb-2 w-100",
                   data: { confirm: "Confirm payment from your wallet?" } %>
            <% end %>

            <%# 2) Paid → Seller Uploads Proof %>
            <% if current_user == @order.seller && @order.paid? %>
              <%= form_with model: @order, url: upload_shipment_order_path(@order),
                            method: :post, local: true, html: { multipart: true } do |f| %>
                <div class="mb-2">
                  <%= f.file_field :shipment_proof, class: "form-control", required: true %>
                </div>
                <%= f.submit "Upload Shipment Proof", class: "btn btn-warning w-100" %>
              <% end %>
            <% end %>

            <%# 3) Shipped → Buyer Releases Funds %>
            <% if current_user == @order.user && @order.shipped? %>
              <%= button_to "Release Funds to Seller",
                   release_escrow_order_path(@order),
                   method: :post,
                   class: "btn btn-primary w-100",
                   data: { confirm: "Are you sure you want to release funds?" } %>
            <% end %>

          </div>
        </div>
      </div>
    </div>

    <!-- ─── ESCROW TIMELINE ───────────────────────────────────────────── -->

  </div>
</section>

<!-- ─── STYLES ─────────────────────────────────────────────────────── -->
<style>
  /* Timeline Styling */
  .timeline {
    position: relative;
    padding-left: 3rem;
  }

  .timeline:before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e9ecef;
    left: 1.5rem;
    z-index: 0;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-marker {
    position: absolute;
    left: -3rem;
    top: 0;
    z-index: 2;
  }

  .timeline-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: white;
    font-size: 1.2rem;
    box-shadow: 0 0 0 5px white;
  }

  .timeline-content {
    background: white;
    border-radius: 0.5rem;
    padding: 1.25rem;
    position: relative;
    border-left: 3px solid #0d6efd;
    transition: transform 0.3s ease;
  }

  .timeline-item:hover .timeline-content {
    transform: translateX(5px);
  }

  /* Progress bar styling */
  .timeline-progress {
    height: 8px;
    background-color: #e9ecef;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #0d6efd, #00c9a7);
    transition: width 0.5s ease;
  }

  /* Status colors */
  .timeline-item.completed .timeline-icon {
    box-shadow: 0 0 0 5px white, 0 0 0 8px rgba(13, 110, 253, 0.2);
  }
</style>
